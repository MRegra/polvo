{
  "name": "polvo",
  "version": "0.4.0",
  "description": "A terminal coding agent, built in small readable increments.",
  "type": "module",
  "bin": {
    "polvo": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ollama": "^0.6.4",
    "react": "^18.3.1",
    "undici": "^6.29.1"
  }
}
